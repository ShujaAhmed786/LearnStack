# LearnStack API
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/db ./packages/db
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
RUN corepack enable && pnpm install --frozen-lockfile
RUN pnpm --filter db exec prisma generate
RUN pnpm --filter db exec tsc --skipLibCheck || true
RUN pnpm --filter @learnstack/shared exec tsc --skipLibCheck || true
RUN cd apps/api && npx tsc --skipLibCheck || true

FROM node:22-alpine AS runner
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
RUN corepack enable && corepack prepare pnpm@12.9.1 --activate
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/db/package.json ./packages/db/
COPY packages/db/prisma ./packages/db/prisma/
COPY packages/db/dist ./packages/db/dist/
COPY packages/shared/package.json ./packages/shared/
COPY packages/shared/dist ./packages/shared/dist/
COPY apps/api/package.json ./apps/api/
COPY apps/api/dist ./apps/api/dist/
# Install ALL deps first (need prisma CLI for generate)
RUN pnpm install --frozen-lockfile
RUN pnpm --filter db exec prisma generate
# Now prune to production only
RUN pnpm prune --prod
USER app
EXPOSE 3001
WORKDIR /app/apps/api
CMD ["node", "dist/index.js"]
