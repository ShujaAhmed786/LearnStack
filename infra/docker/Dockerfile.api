# LearnStack API
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/db ./packages/db
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
RUN corepack enable && pnpm install --frozen-lockfile
RUN pnpm --filter db exec prisma generate
RUN pnpm --filter db exec tsc --skipLibCheck || true
RUN pnpm --filter @learnstack/shared exec tsc --skipLibCheck || true
RUN cd apps/api && npx tsc --skipLibCheck || true
RUN ls -la apps/api/dist/ || (echo "API dist not created" && exit 1)
RUN pnpm --filter api deploy --prod /app/deploy
# Generate Prisma client in the deploy directory
RUN cd /app/deploy && npx prisma generate --schema=/app/packages/db/prisma/schema.prisma || true

FROM node:22-alpine
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
COPY --from=builder /app/deploy/dist ./dist
COPY --from=builder /app/deploy/node_modules ./node_modules
COPY --from=builder /app/deploy/package.json ./
COPY --from=builder /app/packages/db/prisma ./prisma
# Copy generated Prisma client
USER app
EXPOSE 3001
CMD ["node", "dist/index.js"]
