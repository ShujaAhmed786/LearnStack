# LearnStack Terraform - Example variables
# Copy to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to git

# PostgreSQL connection (existing DB node from FitLyfe infra)
db_host           = "10.0.1.10"  # Update with your actual DB private IP
db_port           = "5432"
db_admin_user     = "postgres"
db_admin_password = "CHANGE_ME"

# Kubernetes
kubeconfig_path = "~/.kube/config"

# Domain
app_domain  = "learnstack.yourdomain.com"
cors_origin = "https://learnstack.yourdomain.com"
