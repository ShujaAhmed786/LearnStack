DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learnstack?schema=public"
SESSION_SECRET="your-32-character-session-secret"
CORS_ORIGIN="http://localhost:5173"
PORT="3001"
NODE_ENV="development"
EMAIL_USER=
EMAIL_PASS=

# ========================================================
# ========================================================
# Google OAuth Setup:
# 1. Visit console.cloud.google.com -> APIs & Services -> Credentials
# 2. Create Credentials -> OAuth client ID -> Web application
# 3. Add Authorized redirect URI: http://localhost:3001/v1/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth Setup:
# 1. Visit portal.azure.com -> Microsoft Entra ID -> App registrations -> New registration
# 2. Supported account types: Accounts in any organizational directory & personal Microsoft accounts
# 3. Add Redirect URI (Web): http://localhost:3001/v1/auth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Base callback redirect URL
OAUTH_CALLBACK_URL="http://localhost:3001"
